generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  passwordHash     String?
  firstName        String?
  lastName         String?
  image            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  name             String?
  role             String            @default("user")
  emailVerified    Boolean           @default(false)
  aiModels         Json?             // Custom AI models from OpenRouter
  accounts         Account[]
  applications     Application[]
  coverLetters     CoverLetter[]
  jobAlerts        JobAlert[]
  notifications    Notification[]
  profile          Profile?
  resumes          Resume[]
  savedCompanies   SavedCompany[]
  savedOffers      SavedOffer[]
  searchJobs       SearchJob[]
  sessions         Session[]
  subscription     Subscription?
  skills           UserSkill[]
  careerObjectives CareerObjective[]
  aiConversations  AIConversation[]
  aiInsights       AIInsight[]
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  scope                 String?
  accessToken           String?
  accessTokenExpiresAt  DateTime?
  accountId             String
  createdAt             DateTime  @default(now())
  idToken               String?
  password              String?
  providerId            String
  refreshToken          String?
  refreshTokenExpiresAt DateTime?
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime
  ipAddress String?
  token     String   @unique
  updatedAt DateTime @updatedAt
  userAgent String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Profile {
  id              String   @id @default(cuid())
  userId          String   @unique
  phone           String?
  schoolName      String?
  educationLevel  String?
  specialty       String?
  preferredCities String?
  contractTypes   String?
  domains         String?
  languages       String?
  bio             String?
  linkedinUrl     String?
  portfolioUrl    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Resume {
  id            String   @id @default(cuid())
  userId        String
  fileName      String
  fileType      String
  fileSize      Int
  extractedText String?
  parsedData    String?
  skills        String?
  experience    String?
  education     String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSkill {
  id        String   @id @default(cuid())
  userId    String
  name      String
  category  String?
  level     String?
  source    String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

model JobOffer {
  id             String        @id @default(cuid())
  sourceProvider String
  sourceUrl      String?
  externalId     String?
  title          String
  companyName    String
  companyLogo    String?
  location       String?
  remoteType     String?
  contractType   String?
  duration       String?
  salaryMin      Int?
  salaryMax      Int?
  salaryRaw      String?
  description    String?
  requirements   String?
  skills         String?
  publishedAt    DateTime?
  expiresAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  applications   Application[]
  savedOffers    SavedOffer[]

  @@unique([sourceProvider, externalId])
}

model Company {
  id             String         @id @default(cuid())
  name           String
  domain         String?
  website        String?
  logo           String?
  sector         String?
  size           String?
  description    String?
  location       String?
  linkedinUrl    String?
  glassdoorUrl   String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  savedCompanies SavedCompany[]
}

model SavedOffer {
  id         String   @id @default(cuid())
  userId     String
  offerId    String
  notes      String?
  matchScore Int?
  matchData  String?
  createdAt  DateTime @default(now())
  offer      JobOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, offerId])
}

model SavedCompany {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  notes     String?
  priority  Int      @default(0)
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
}

model Application {
  id                 String             @id @default(cuid())
  userId             String
  offerId            String?
  companyName        String
  jobTitle           String
  status             ApplicationStatus  @default(NOT_APPLIED)
  appliedAt          DateTime?
  lastContactAt      DateTime?
  interviewAt        DateTime?
  notes              String?
  coverLetterId      String?
  matchScore         Int?
  nextAction         String?
  nextActionAt       DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  companyUrl         String?
  contactEmail       String?
  contactName        String?
  emailContent       String?
  emailSent          Boolean            @default(false)
  emailSentAt        DateTime?
  responseContent    String?
  responseReceived   Boolean            @default(false)
  responseReceivedAt DateTime?
  responseScreenshot String?
  responseType       String?
  offer              JobOffer?          @relation(fields: [offerId], references: [id])
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  timeline           ApplicationEvent[]
}

model ApplicationEvent {
  id            String      @id @default(cuid())
  applicationId String
  type          String
  title         String
  description   String?
  metadata      String?
  createdAt     DateTime    @default(now())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model CoverLetter {
  id          String   @id @default(cuid())
  userId      String
  companyName String
  jobTitle    String
  content     String
  language    String   @default("fr")
  tone        String   @default("professional")
  offerUrl    String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripePriceId        String?
  plan                 PlanType           @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  searchesUsed         Int                @default(0)
  lettersUsed          Int                @default(0)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SearchJob {
  id               String          @id @default(cuid())
  userId           String
  query            String
  location         String?
  providers        String
  status           SearchJobStatus @default(QUEUED)
  progress         Int             @default(0)
  step             SearchStep      @default(RESUME_ANALYSIS)
  providerStatuses String?
  resultsCount     Int?
  error            String?
  startedAt        DateTime?
  finishedAt       DateTime?
  createdAt        DateTime        @default(now())
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model JobAlert {
  id            String         @id @default(cuid())
  userId        String
  name          String
  domains       String
  keywords      String?
  locations     String?
  contractTypes String?
  minMatchScore Int            @default(50)
  isActive      Boolean        @default(true)
  frequency     String         @default("daily")
  lastCheckedAt DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications Notification[]
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  alertId   String?
  type      String
  title     String
  message   String
  data      String?
  isRead    Boolean   @default(false)
  createdAt DateTime  @default(now())
  alert     JobAlert? @relation(fields: [alertId], references: [id])
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum ApplicationStatus {
  NOT_APPLIED
  APPLIED
  IN_PROGRESS
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
  INCOMPLETE
}

enum PlanType {
  FREE
  STARTER
  PRO
  ELITE
}

enum SearchJobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
  CANCELED
}

enum SearchStep {
  RESUME_ANALYSIS
  PROVIDER_FETCH
  DEDUPLICATION
  SCORING
  RECOMMENDATIONS
}

// Objectifs de carrière de l'utilisateur
model CareerObjective {
  id              String   @id @default(cuid())
  userId          String
  objective       String   // L'objectif de carrière décrit par l'utilisateur
  targetRoles     String?  // Postes ciblés (JSON array)
  targetSectors   String?  // Secteurs ciblés (JSON array)
  targetCompanies String?  // Entreprises ciblées (JSON array)
  salaryRange     String?  // Fourchette salariale souhaitée
  timeline        String?  // Horizon temporel (ex: "6 mois", "1 an")
  priorities      String?  // Priorités (remote, salaire, mission, etc.)
  constraints     String?  // Contraintes (géographiques, etc.)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Conversations avec l'assistant IA
model AIConversation {
  id           String      @id @default(cuid())
  userId       String
  title        String?     // Titre auto-généré de la conversation
  summary      String?     // Résumé de la conversation
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     AIMessage[]
  insights     AIInsight[]
}

// Messages individuels dans une conversation
model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  role           String         // "user" | "assistant"
  content        String
  model          String?        // Modèle utilisé (gpt-4o-mini, etc.)
  attachments    String?        // Fichiers joints (JSON)
  createdAt      DateTime       @default(now())
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

// Insights et conseils extraits des conversations
model AIInsight {
  id             String          @id @default(cuid())
  conversationId String?
  userId         String
  type           String          // "skill_suggestion" | "company_recommendation" | "strategy" | "cv_improvement" | "interview_tip"
  content        String          // Le conseil ou insight
  metadata       String?         // Données additionnelles (JSON)
  isApplied      Boolean         @default(false) // Si l'utilisateur a appliqué le conseil
  relevanceScore Int             @default(100)   // Score de pertinence (0-100)
  createdAt      DateTime        @default(now())
  conversation   AIConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}
