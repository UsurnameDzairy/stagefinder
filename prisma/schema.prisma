generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  firstName     String?
  lastName      String?
  image         String?
  emailVerified Boolean   @default(false)
  role          String    @default("user")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile       Profile?
  resumes       Resume[]
  skills        UserSkill[]
  savedOffers   SavedOffer[]
  savedCompanies SavedCompany[]
  applications  Application[]
  coverLetters  CoverLetter[]
  subscription  Subscription?
  searchJobs    SearchJob[]
  accounts      Account[]
  sessions      Session[]
  jobAlerts     JobAlert[]
  notifications Notification[]
}

model Account {
  id                String   @id @default(cuid())
  accountId         String
  providerId        String
  userId            String
  accessToken       String?
  refreshToken      String?
  idToken           String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope             String?
  password          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  expiresAt    DateTime
  token        String   @unique
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Profile {
  id              String   @id @default(cuid())
  userId          String   @unique
  phone           String?
  schoolName      String?
  educationLevel  String?
  specialty       String?
  preferredCities String?
  contractTypes   String?
  domains         String?
  languages       String?
  bio             String?
  linkedinUrl     String?
  portfolioUrl    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Resume {
  id            String   @id @default(cuid())
  userId        String
  fileName      String
  fileType      String
  fileSize      Int
  extractedText String?
  parsedData    String?
  skills        String?
  experience    String?
  education     String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSkill {
  id        String   @id @default(cuid())
  userId    String
  name      String
  category  String?
  level     String?
  source    String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

model JobOffer {
  id              String   @id @default(cuid())
  sourceProvider  String
  sourceUrl       String?
  externalId      String?
  title           String
  companyName     String
  companyLogo     String?
  location        String?
  remoteType      String?
  contractType    String?
  duration        String?
  salaryMin       Int?
  salaryMax       Int?
  salaryRaw       String?
  description     String?
  requirements    String?
  skills          String?
  publishedAt     DateTime?
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  savedOffers  SavedOffer[]
  applications Application[]

  @@unique([sourceProvider, externalId])
}

model Company {
  id          String   @id @default(cuid())
  name        String
  domain      String?
  website     String?
  logo        String?
  sector      String?
  size        String?
  description String?
  location    String?
  linkedinUrl String?
  glassdoorUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  savedCompanies SavedCompany[]
}

model SavedOffer {
  id         String   @id @default(cuid())
  userId     String
  offerId    String
  notes      String?
  matchScore Int?
  matchData  String?
  createdAt  DateTime @default(now())

  user  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  offer JobOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([userId, offerId])
}

model SavedCompany {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  notes     String?
  priority  Int      @default(0)
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
}

enum ApplicationStatus {
  NOT_APPLIED
  APPLIED
  IN_PROGRESS
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

model Application {
  id            String            @id @default(cuid())
  userId        String
  offerId       String?
  companyName   String
  jobTitle      String
  status        ApplicationStatus @default(NOT_APPLIED)
  appliedAt     DateTime?
  lastContactAt DateTime?
  interviewAt   DateTime?
  notes         String?
  coverLetterId String?
  matchScore    Int?
  nextAction    String?
  nextActionAt  DateTime?
  
  // Tracking des étapes
  emailSent         Boolean   @default(false)
  emailSentAt       DateTime?
  emailContent      String?
  responseReceived  Boolean   @default(false)
  responseReceivedAt DateTime?
  responseType      String?   // positive, negative, interview, pending
  responseContent   String?
  responseScreenshot String?  // URL du screenshot uploadé
  
  // Contact entreprise
  contactEmail      String?
  contactName       String?
  companyUrl        String?
  
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  offer     JobOffer?          @relation(fields: [offerId], references: [id], onDelete: SetNull)
  timeline  ApplicationEvent[]
}

model ApplicationEvent {
  id            String   @id @default(cuid())
  applicationId String
  type          String   // applied, email_sent, response_received, interview_scheduled, etc.
  title         String
  description   String?
  metadata      String?  // JSON data
  createdAt     DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model CoverLetter {
  id          String   @id @default(cuid())
  userId      String
  companyName String
  jobTitle    String
  content     String
  language    String   @default("fr")
  tone        String   @default("professional")
  offerUrl    String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
  INCOMPLETE
}

enum PlanType {
  FREE
  STARTER
  PRO
  ELITE
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripePriceId        String?
  plan                 PlanType           @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  searchesUsed         Int                @default(0)
  lettersUsed          Int                @default(0)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum SearchJobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
  CANCELED
}

enum SearchStep {
  RESUME_ANALYSIS
  PROVIDER_FETCH
  DEDUPLICATION
  SCORING
  RECOMMENDATIONS
}

model SearchJob {
  id               String          @id @default(cuid())
  userId           String
  query            String
  location         String?
  providers        String
  status           SearchJobStatus @default(QUEUED)
  progress         Int             @default(0)
  step             SearchStep      @default(RESUME_ANALYSIS)
  providerStatuses String?
  resultsCount     Int?
  error            String?
  startedAt        DateTime?
  finishedAt       DateTime?
  createdAt        DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Job Alerts - Alertes pour les nouvelles offres
model JobAlert {
  id            String   @id @default(cuid())
  userId        String
  name          String   // Ex: "Stage Finance Paris"
  domains       String   // Domaines séparés par des virgules
  keywords      String?  // Mots-clés additionnels
  locations     String?  // Localisations préférées
  contractTypes String?  // Types de contrat (stage, alternance, cdi)
  minMatchScore Int      @default(50) // Score minimum pour alerter
  isActive      Boolean  @default(true)
  frequency     String   @default("daily") // instant, daily, weekly
  lastCheckedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications Notification[]
}

// Notifications utilisateur
model Notification {
  id          String   @id @default(cuid())
  userId      String
  alertId     String?
  type        String   // job_match, application_update, system
  title       String
  message     String
  data        String?  // JSON data (offerId, etc.)
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  alert       JobAlert? @relation(fields: [alertId], references: [id], onDelete: SetNull)
}
